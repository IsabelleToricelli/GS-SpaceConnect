<Window x:Class="GS_SpaceConnect.CadastroPropriedadeAgricola"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GS_SpaceConnect"
        mc:Ignorable="d"
        Title="Cadastrar Nova Propriedade" Height="350" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F6F8">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Nova Propriedade Rural" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5" HorizontalAlignment="Center"/>
            <TextBlock Text="Insira os dados da fazenda para o monitoramento" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Nome da Fazenda / Estufa:" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNome" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="8,0,0,0" FontSize="14" Background="White"/>

            <TextBlock Text="Região Localizada:" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbRegiao" Height="35" Margin="0,0,0,25" VerticalContentAlignment="Center" Padding="8,0,0,0" FontSize="14" Background="White">
                <ComboBoxItem Content="Sudeste"/>
                <ComboBoxItem Content="Nordeste"/>
                <ComboBoxItem Content="Sul"/>
                <ComboBoxItem Content="Centro-Oeste"/>
                <ComboBoxItem Content="Norte"/>
            </ComboBox>

            <Button x:Name="btnSalvar" Content="Salvar Propriedade" Height="40" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14" Click="BtnSalvar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>