<Window x:Class="GS_SpaceConnect.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GS_SpaceConnect"
        mc:Ignorable="d"
        Title="SpaceConnect - Acesso ao Sistema" Height="350" Width="500" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F5F6F8">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Selecione a Propriedade Rural" FontSize="22" FontWeight="Bold" 
                       Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,5"/>

            <TextBlock Text="Escolha a fazenda ativa para monitoramento" FontSize="13" 
                       Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Propriedade Rural Ativa:" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>

            <ComboBox x:Name="cbFazendas" Height="40" DisplayMemberPath="Nome" Margin="0,0,0,30"
                      Background="White" VerticalContentAlignment="Center" Padding="8,0,0,0" FontSize="14"/>

            <Button x:Name="btnEntrar" Content="Entrar no Painel" Height="45" Background="#27AE60" 
                    Foreground="White" FontWeight="Bold" FontSize="15" Click="BtnEntrar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock HorizontalAlignment="Center" Margin="0,15,0,0" FontSize="13">
    <Hyperlink x:Name="lnkCadastrar" 
               Foreground="#2980b9" 
               NavigateUri="CadastroPropriedadeAgricola.xaml"
               Click="BtnCadastrar_Click">
        ➕ Cadastrar Nova Fazenda
    </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
