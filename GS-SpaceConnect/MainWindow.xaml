<Window x:Class="GS_SpaceConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GS_SpaceConnect"
        mc:Ignorable="d"
        Title="MainWindow" Height="452" Width="804">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="24,30,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <TextBlock Text="SpaceConnect" FontSize="24" FontWeight="Black" Foreground="#1A202C"/>
                    <TextBlock Text="Monitoramento Agrícola Espacial" FontSize="12" Foreground="#718096" FontWeight="Medium" Margin="0,2,0,0"/>

                    <Separator Background="#EDF2F7" Margin="0,15,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0,0,5,0" Margin="0,0,0,25" Grid.Row="1">
                    <StackPanel>
                        <TextBlock Text="Identificação do Sensor" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6"/>
                        <Border CornerRadius="6" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,16">
                            <TextBox x:Name="txtNomeSensor" Height="32" Padding="8,4" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#2D3748"/>
                        </Border>

                        <TextBlock Text="Temperatura (°C)" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6"/>
                        <Border CornerRadius="6" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,16">
                            <TextBox x:Name="txtTemperatura" Height="32" Padding="8,4" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#2D3748"/>
                        </Border>

                        <TextBlock Text="Umidade (%)" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6"/>
                        <Border CornerRadius="6" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,16">
                            <TextBox x:Name="txtUmidade" Height="32" Padding="8,4" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#2D3748"/>
                        </Border>

                        <TextBlock Text="Luminosidade (lux)" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,6"/>
                        <Border CornerRadius="6" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,16">
                            <TextBox x:Name="txtLuminosidade" Height="32" Padding="8,4" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#2D3748"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Button Content="Salvar Análise" Click="BtnSalvar_Click" Height="40" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2B6CB0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2C5282"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="⬅ Voltar para o Login" 
                            Click="BtnVoltarLogin_Click"
                            Background="Transparent" 
                            Foreground="#64748B" 
                            FontWeight="Medium"
                            FontSize="11"
                            BorderThickness="0" 
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#2B6CB0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#F8FAFC" Margin="0">
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Painel de Controle Espacial" FontSize="20" FontWeight="Bold" Foreground="#1A202C"/>
                    <TextBlock Text="Selecione uma linha da tabela para Analisar, Atualizar ou Deletar registros." FontSize="12" Foreground="#718096" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.04" Color="#000000"/>
                    </Border.Effect>
                    <Grid Margin="12">
                        <DataGrid x:Name="dgAnalises" AutoGenerateColumns="True" IsReadOnly="True" 
                                  Background="Transparent" BorderThickness="0" RowHeight="36"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                  HeadersVisibility="Column" AlternatingRowBackground="#F8FAFC">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,6,10,6"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </Border>

                <UniformGrid Grid.Row="2" Columns="3" Margin="0,15,0,15">
                    <Button Content="🔍 Diagnosticar Leitura" Click="BtnAnalisar_Click" Height="36" Margin="0,0,5,0" Background="#3182CE" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Style.Resources>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✏️ Editar Selecionado" Click="BtnAtualizar_Click" Height="36" Margin="5,0,5,0" Background="#DD6B20" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Style.Resources>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="❌ Excluir Registro" Click="BtnDeletar_Click" Height="36" Margin="5,0,0,0" Background="#E53E3E" Foreground="White" FontWeight="Bold" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Style.Resources>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>

                <Border Grid.Row="3" Background="#EDF2F7" CornerRadius="8" Padding="12" Height="140">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Sistema de Recomendação (IA Agro)" 
                                   FontWeight="Bold" Foreground="#2D3748" FontSize="12" Margin="0,0,0,6"/>

                        <Button Grid.Row="1" Content="🧹 Limpar Diagnóstico" Click="BtnLimparDiagnostico_Click" 
                                HorizontalAlignment="Left" Padding="10,4,10,4" Margin="0,0,0,6"
                                Background="#718096" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="11">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Style.Resources>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBox x:Name="txtDiagnostico" Grid.Row="2" IsReadOnly="True" Background="Transparent" 
                                 BorderThickness="0" TextWrapping="Wrap" FontSize="12" Foreground="#4A5568" 
                                 VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Disabled"
                                 Text="Selecione um registro de sensor acima e clique em 'Diagnosticar Leitura' para simular a tomada de decisão baseada no JSON de regras agrícolas."/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>